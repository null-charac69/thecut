{
  "name": "the-cut",
  "private": true,
  "type": "module",
  "description": "THE CUT: dev tooling only. The app itself has no build step (see docs/TESTING.md).",
  "scripts": {
    "test:unit": "node --experimental-strip-types --no-warnings --test tests/unit/*.test.mjs",
    "test:api": "python3 -m pytest tests/api -q",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:db && npm run test:ui",
    "test:db": "node --test tests/db/*.test.mjs",
    "test:ui": "playwright test -c tests/ui/playwright.config.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.49.0",
    "@supabase/supabase-js": "^2.81.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.6.0"
  }
}
